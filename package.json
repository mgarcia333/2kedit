{
  "name": "2kedit",
  "version": "1.0.0",
  "description": "2kedit — Professional local video editor with cinematic aesthetics",
  "main": "electron/main.js",
  "author": "2kedit",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "build:win": "vite build && tsc -p tsconfig.electron.json && electron-builder --win",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "download-ffmpeg": "node scripts/download-ffmpeg.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "fluent-ffmpeg": "^2.1.3",
    "zustand": "^4.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/node": "^20.14.9",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-electron": "^0.28.7",
    "wait-on": "^7.2.0",
    "node-fetch": "^3.3.2",
    "extract-zip": "^2.0.1"
  }
}
